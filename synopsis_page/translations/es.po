#, python-format
msgid "%d item(s) were not processed. See the details."
msgstr "%d elemento(s) no se procesaron. Mirá los detalles."

msgid "About Synopsis Page"
msgstr "Acerca de Hoja de Sinopsis"

msgid "About…"
msgstr "Acerca de…"

msgid "Add it to the Table of Contents as:"
msgstr "Agregarla al índice con el nombre:"

msgid "Add synopsis page"
msgstr "Agregar hoja de sinopsis"

msgid "Adding page…"
msgstr "Agregando hoja…"

msgid ""
"Adds a page with the book cover and its synopsis (Comments field) to EPUB "
"and AZW3 books."
msgstr ""
"Agrega a los libros EPUB y AZW3 una hoja con la portada y la sinopsis (campo"
" Comentarios)."

msgid ""
"Adds a page with the book cover and its synopsis, taken from the calibre "
"Comments field, to EPUB and AZW3 books."
msgstr ""
"Agrega a los libros EPUB y AZW3 una hoja con la portada y la sinopsis, "
"tomada del campo Comentarios de calibre."

msgid "Adds a page with the cover and the synopsis to the book"
msgstr "Agrega al libro una hoja con la portada y la sinopsis"

msgid "After paragraph "
msgstr "Después del párrafo "

msgid "After the cover"
msgstr "Después de la portada"

#, python-format
msgid "An older page was replaced in %d of them."
msgstr "En %d de ellos se reemplazó una hoja anterior."

msgid "At the end of the book"
msgstr "Al final del libro"

msgid "At the start of the book"
msgstr "Al principio del libro"

msgid "At the start of the text"
msgstr "Al comienzo del texto"

msgid "Border with shadow"
msgstr "Borde con sombra"

msgid "Bottom, after the synopsis"
msgstr "Abajo, después de la sinopsis"

msgid "Cancel"
msgstr "Cancelar"

